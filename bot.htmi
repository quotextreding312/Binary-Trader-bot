<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Binary Trader Bot</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            text-align: center;
            padding: 20px;
            margin: 0;
        }
        .container {
            max-width: 400px;
            margin: auto;
            background: #1e1e1e;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        h2 { color: #00e676; margin-bottom: 20px; }
        select, button {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 6px;
            border: none;
            font-size: 16px;
        }
        select { background: #2a2a2a; color: #fff; }
        button {
            background-color: #00e676;
            color: #000;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover { background-color: #00c853; }
        .result-box {
            margin-top: 20px;
            padding: 15px;
            background: #2a2a2a;
            border-radius: 8px;
        }
        .signal { font-size: 20px; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <h2>🤖 Binary Trader Bot</h2>
    
    <label for="assetSelect">মার্কেট পেয়ার সিলেক্ট করুন:</label>
    <select id="assetSelect">
        <optgroup label="🔥 Crypto Pairs">
            <option value="BTCUSDT">BTC/USDT</option>
            <option value="ETHUSDT">ETH/USDT</option>
            <option value="BNBUSDT">BNB/USDT</option>
            <option value="SOLUSDT">SOL/USDT</option>
            <option value="XRPUSDT">XRP/USDT</option>
            <option value="ADAUSDT">ADA/USDT</option>
            <option value="DOGEUSDT">DOGE/USDT</option>
        </optgroup>
    </select>

    <button onclick="fetchSignal()">START SCANNING</button>

    <div class="result-box">
        <div>RSI (14) Value: <span id="rsiVal">--</span></div>
        <div class="signal" id="signalText">WAITING...</div>
    </div>
</div>

<script>
async function fetchSignal() {
    const symbol = document.getElementById('assetSelect').value;
    document.getElementById('signalText').innerText = "SCANNING...";
    document.getElementById('signalText').style.color = "#ffeb3b";
    
    const url = `https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=1m&limit=30`;

    try {
        const response = await fetch(url);
        const data = await response.json();
        const closePrices = data.map(candle => parseFloat(candle[4]));
        const rsi = calculateRSI(closePrices, 14);
        
        document.getElementById('rsiVal').innerText = rsi.toFixed(1);
        updateSignal(rsi);
    } catch (error) {
        console.error("Error fetching data:", error);
        document.getElementById('signalText').innerText = "FETCH ERROR";
        document.getElementById('signalText').style.color = "#f44336";
    }
}

function calculateRSI(prices, period = 14) {
    let gains = 0, losses = 0;
    for (let i = 1; i <= period; i++) {
        const change = prices[i] - prices[i - 1];
        if (change >= 0) gains += change;
        else losses -= change;
    }
    let avgGain = gains / period;
    let avgLoss = losses / period;

    for (let i = period + 1; i < prices.length; i++) {
        const change = prices[i] - prices[i - 1];
        if (change >= 0) {
            avgGain = (avgGain * 13 + change) / 14;
            avgLoss = (avgLoss * 13) / 14;
        } else {
            avgGain = (avgGain * 13) / 14;
            avgLoss = (avgLoss * 13 - change) / 14;
        }
    }
    if (avgLoss === 0) return 100;
    const rs = avgGain / avgLoss;
    return 100 - (100 / (1 + rs));
}

function updateSignal(rsi) {
    const signalElem = document.getElementById('signalText');
    if (rsi <= 30) {
        signalElem.innerText = "CALL (BUY ⬆️)";
        signalElem.style.color = "#00e676";
    } else if (rsi >= 70) {
        signalElem.innerText = "PUT (SELL ⬇️)";
        signalElem.style.color = "#ff5252";
    } else {
        signalElem.innerText = "NEUTRAL (NO TRADE ⏳)";
        signalElem.style.color = "#ffffff";
    }
}
</script>

</body>
</html>
