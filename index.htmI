<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Quotex Live Binary Signal Scanner</title> <style> body { background-color: #0d1117; color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box; } .card { background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 25px; width: 100%; max-width: 420px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); text-align: center; } h2 { margin-top: 0; font-size: 20px; color: #58a6ff; } .select-label { display: block; text-align: left; font-size: 14px; color: #8b949e; margin-bottom: 8px; } .select-box { width: 100%; padding: 12px; background: #21262d; border: 1px solid #30363d; color: #fff; border-radius: 8px; font-size: 15px; outline: none; margin-bottom: 20px; } .timeframe { font-size: 14px; color: #8b949e; margin-bottom: 20px; } .signal-circle { width: 90px; height: 90px; border-radius: 50%; background: #21262d; display: flex; justify-content: center; align-items: center; font-size: 36px; margin: 0 auto 15px auto; border: 3px solid #30363d; transition: all 0.3s ease; } .signal-status { font-size: 22px; font-weight: bold; letter-spacing: 1px; margin-bottom: 25px; min-height: 30px; } .btn-start { width: 100%; padding: 14px; border: none; border-radius: 8px; background: #238636; color: #fff; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.2s ease; margin-bottom: 20px; } .btn-start:hover { background: #2ea043; } .btn-start.stop { background: #da3633; } .btn-start.stop:hover { background: #f85149; } .stats-container { display: flex; justify-content: space-between; gap: 10px; background: #0d1117; padding: 12px; border-radius: 8px; border: 1px solid #21262d; } .stat-box { flex: 1; } .stat-label { font-size: 12px; color: #8b949e; margin-bottom: 4px; } .stat-value { font-size: 16px; font-weight: bold; } </style> </head> <body> <div class="card"> <h2>📊 Quotex Binary Scanner</h2> <label class="select-label">Select Trading Asset:</label> <select id="assetSelect" class="select-box" onchange="changeAsset()"> <optgroup label="🔥 Top Crypto Pairs"> <option value="BTCUSDT">BTC/USDT (Bitcoin)</option> <option value="ETHUSDT">ETH/USDT (Ethereum)</option> <option value="SOLUSDT">SOL/USDT (Solana)</option> <option value="XRPUSDT">XRP/USDT (Ripple)</option> <option value="DOGEUSDT">DOGE/USDT (Dogecoin)</option> <option value="BNBUSDT">BNB/USDT (Binance Coin)</option> <option value="LTCUSDT">LTC/USDT (Litecoin)</option> </optgroup> <optgroup label="🌐 Live Forex Pairs"> <option value="EURUSDT">EUR/USD (Live)</option> <option value="GBPUSDT">GBP/USD (Live)</option> <option value="USDJPY">USD/JPY (Live)</option> <option value="EURJPY">EUR/JPY (Live)</option> <option value="GBPJPY">GBP/JPY (Live)</option> </optgroup> </select> <div class="timeframe">Timeframe: <b>1 Minute (1M)</b></div> <div class="signal-circle" id="signalIcon">🔍</div> <div class="signal-status" id="signalText" style="color: #8b949e;">SCANNER IDLE</div> <button class="btn-start" id="scanBtn" onclick="toggleScanner()">START SCANNING</button> <div class="stats-container"> <div class="stat-box"> <div class="stat-label">RSI Value</div> <div class="stat-value" id="rsiVal">--</div> </div> <div class="stat-box"> <div class="stat-label">Scanner Status</div> <div class="stat-value" id="scannerStatus" style="color: #ff922b;">Stopped</div> </div> </div> </div> <script> let isScanning = false; let intervalId = null; function changeAsset() { if (isScanning) { fetchRSI(); } } function toggleScanner() { const btn = document.getElementById('scanBtn'); const statusText = document.getElementById('scannerStatus'); if (!isScanning) { isScanning = true; btn.innerText = "STOP SCANNING"; btn.classList.add('stop'); statusText.innerText = "Active"; statusText.style.color = "#3fb950"; fetchRSI(); intervalId = setInterval(fetchRSI, 5000); // 5 সেকেন্ড পর পর ডাটা আপডেট হবে } else { isScanning = false; btn.innerText = "START SCANNING"; btn.classList.remove('stop'); statusText.innerText = "Stopped"; statusText.style.color = "#ff922b"; clearInterval(intervalId); resetUI(); } } function resetUI() { document.getElementById('signalIcon').innerText = "🔍"; document.getElementById('signalIcon').style.borderColor = "#30363d"; document.getElementById('signalText').innerText = "SCANNER IDLE"; document.getElementById('signalText').style.color = "#8b949e"; document.getElementById('rsiVal').innerText = "--"; } async function fetchRSI() { const symbol = document.getElementById('assetSelect').value; const url = `https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=1m&limit=30`; try { const response = await fetch(url); const data = await response.json(); const closePrices = data.map(candle => parseFloat(candle[4])); const rsi = calculateRSI(closePrices, 14); document.getElementById('rsiVal').innerText = rsi.toFixed(1); updateSignal(rsi); } catch (error) { console.error("Error fetching data:", error); document.getElementById('signalText').innerText = "FETCH ERROR"; document.getElementById('signalText').style.color = "#f85149"; } } function calculateRSI(prices, period = 14) { let gains = 0; let losses = 0; for (let i = 1; i <= period; i++) { const change = prices[i] - prices[i - 1]; if (change >= 0) gains += change; else losses += Math.abs(change); } let avgGain = gains / period; let avgLoss = losses / period; for (let i = period + 1; i < prices.length; i++) { const change = prices[i] - prices[i - 1]; if (change >= 0) { avgGain = (avgGain * 13 + change) / 14; avgLoss = (avgLoss * 13) / 14; } else { avgGain = (avgGain * 13) / 14; avgLoss = (avgLoss * 13 + Math.abs(change)) / 14; } } if (avgLoss === 0) return 100; const rs = avgGain / avgLoss; return 100 - (100 / (1 + rs)); } function updateSignal(rsi) { const icon = document.getElementById('signalIcon'); const text = document.getElementById('signalText'); if (rsi <= 32) { icon.innerText = "🟢"; icon.style.borderColor = "#238636"; text.innerText = "CALL (BUY 1M)"; text.style.color = "#3fb950"; } else if (rsi >= 68) { icon.innerText = "🔴"; icon.style.borderColor = "#da3633"; text.innerText = "PUT (SELL 1M)"; text.style.color = "#f85149"; } else { icon.innerText = "⏳"; icon.style.borderColor = "#30363d"; text.innerText = "WAITING FOR SIGNAL"; text.style.color = "#d29922"; } } </script> </body> </html>