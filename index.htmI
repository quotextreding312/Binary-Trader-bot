<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Advanced Binary Signal Scanner</title>
  <style>
    body {
      background-color: #0d0d1a;
      color: white;
      font-family: 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 15px;
    }
    .card {
      background: #161625;
      border: 1px solid #2a2a40;
      border-radius: 18px;
      padding: 20px;
      width: 100%;
      max-width: 350px;
      text-align: center;
      box-shadow: 0 8px 30px rgba(0,0,0,0.6);
    }
    .header {
      font-size: 16px;
      color: #00d2ff;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 15px;
    }
    .select-box {
      width: 100%;
      padding: 10px;
      background: #222238;
      border: 1px solid #3a3a5c;
      color: #fff;
      border-radius: 8px;
      font-size: 15px;
      margin-bottom: 15px;
      outline: none;
    }
    .timeframe { color: #8a8aab; font-size: 13px; margin-bottom: 15px; }
    .signal-circle {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid #4a4a6a;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px auto;
      font-size: 45px;
      color: #8a8aab;
      background: rgba(255, 255, 255, 0.03);
      transition: all 0.3s ease;
    }
    .btn-start {
      background: linear-gradient(90deg, #00c6ff, #0072ff);
      color: white;
      padding: 12px 0;
      border-radius: 8px;
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 15px;
      cursor: pointer;
      border: none;
      width: 100%;
      box-shadow: 0 4px 15px rgba(0, 114, 255, 0.4);
    }
    .btn-start:active { opacity: 0.8; }
    .signal-status {
      padding: 10px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 15px;
      background: #222238;
      color: #aaa;
    }
    .stats-container { display: flex; justify-content: space-between; gap: 8px; }
    .stat-box {
      background: #222238;
      padding: 8px;
      border-radius: 8px;
      flex: 1;
    }
    .stat-label { font-size: 10px; color: #8a8aab; text-transform: uppercase; margin-bottom: 3px; }
    .stat-value { font-size: 14px; font-weight: bold; color: #00d2ff; }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">⚡ Binary Market Scanner</div>
    
    <!-- Asset Selector -->
    <select id="assetSelect" class="select-box" onchange="changeAsset()">
      <option value="EURUSDT">EUR/USDT (Live Market)</option>
      <option value="GBPUSDT">GBP/USDT (Live Market)</option>
      <option value="BTCUSDT">BTC/USDT (Crypto)</option>
      <option value="USDJPY">USD/JPY (Live Market)</option>
    </select>

    <div class="timeframe">Timeframe: 1 Minute (1M)</div>

    <div class="signal-circle" id="signalIcon">🔍</div>

    <div class="signal-status" id="signalText">SCANNER IDLE</div>

    <button class="btn-start" id="scanBtn" onclick="toggleScanner()">START SCANNING</button>

    <div class="stats-container">
      <div class="stat-box">
        <div class="stat-label">RSI Value</div>
        <div class="stat-value" id="rsiVal">--</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">Scanner Status</div>
        <div class="stat-value" id="scannerStatus" style="color: #ff9500;">OFF</div>
      </div>
    </div>
  </div>

  <script>
    let isScanning = false;
    let timer = null;

    function toggleScanner() {
      const btn = document.getElementById('scanBtn');
      const status = document.getElementById('scannerStatus');

      if (!isScanning) {
        isScanning = true;
        btn.innerText = "STOP SCANNER";
        btn.style.background = "linear-gradient(90deg, #ff416c, #ff4b2b)";
        status.innerText = "ACTIVE";
        status.style.color = "#34c759";
        runScanner();
        timer = setInterval(runScanner, 4000);
      } else {
        isScanning = false;
        btn.innerText = "START SCANNING";
        btn.style.background = "linear-gradient(90deg, #00c6ff, #0072ff)";
        status.innerText = "OFF";
        status.style.color = "#ff9500";
        clearInterval(timer);
        resetUI();
      }
    }

    function changeAsset() {
      if (isScanning) {
        runScanner();
      }
    }

    function resetUI() {
      document.getElementById('signalIcon').innerText = "🔍";
      document.getElementById('signalText').innerText = "SCANNER IDLE";
      document.getElementById('signalText').style.backgroundColor = "#222238";
      document.getElementById('signalText').style.color = "#aaa";
      document.getElementById('rsiVal').innerText = "--";
    }

    async function runScanner() {
      if (!isScanning) return;

      const symbol = document.getElementById('assetSelect').value;
      const statusText = document.getElementById('signalText');
      statusText.innerText = "SCANNING MARKET...";

      try {
        const res = await fetch(`https://api.binance.com/api/v3/klines?symbol=${symbol}&interval=1m&limit=20`);
        const data = await res.json();
        
        const closes = data.map(candle => parseFloat(candle[4]));

        // RSI Calculation
        let gains = 0, losses = 0;
        for (let i = closes.length - 14; i < closes.length; i++) {
          const diff = closes[i] - closes[i - 1];
          if (diff >= 0) gains += diff;
          else losses -= diff;
        }
        const avgGain = gains / 14;
        const avgLoss = losses / 14;
        const rs = avgGain / (avgLoss || 1);
        const rsi = Math.round(100 - (100 / (1 + rs)));

        document.getElementById('rsiVal').innerText = rsi;

        const icon = document.getElementById('signalIcon');

        if (rsi <= 32) {
          icon.innerText = "↗";
          icon.style.borderColor = "#34c759";
          icon.style.color = "#34c759";
          statusText.innerText = "CALL / BUY SIGNAL";
          statusText.style.backgroundColor = "#34c759";
          statusText.style.color = "#fff";
        } else if (rsi >= 68) {
          icon.innerText = "↘";
          icon.style.borderColor = "#ff3b30";
          icon.style.color = "#ff3b30";
          statusText.innerText = "PUT / SELL SIGNAL";
          statusText.style.backgroundColor = "#ff3b30";
          statusText.style.color = "#fff";
        } else {
          icon.innerText = "⏳";
          icon.style.borderColor = "#4a4a6a";
          icon.style.color = "#aaa";
          statusText.innerText = "WAITING FOR ENTRY";
          statusText.style.backgroundColor = "#222238";
          statusText.style.color = "#aaa";
        }

      } catch (err) {
        statusText.innerText = "MARKET DATA ERROR";
      }
    }
  </script>

</body>
</html>